#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable replayshield.service
        fi
        cat <<'EOF'
[ReplayShield setup]
1) Cache the admin password in RAM, then start the service:
   sudo replayshield password && sudo systemctl start replayshield

2) Add both PAM hooks below.
   Add this auth hook to your PAM policy (e.g. /etc/pam.d/sshd):
   auth required pam_exec.so quiet expose_authtok /usr/lib/replayshield/replayshield-pam.sh

3) Add this session hook to both /etc/pam.d/sshd and /etc/pam.d/login:
   session optional pam_exec.so /usr/lib/replayshield/replayshield-login-notify.sh

4) Recommended: remove the default Unix password auth if you deliberately replaced it
   (e.g. comment out '@include common-auth').
EOF
        ;;
esac

exit 0
